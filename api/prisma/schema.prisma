generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // CJS + bare imports: one output that tsx, ts-jest and Vercel's Node build all load without ESM config.
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

enum Role {
  FAN
  STAFF
}

model User {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @db.VarChar(80)
  role            Role             @default(FAN)
  createdAt       DateTime         @default(now())
  tickets         Ticket[]
  bookingRequests BookingRequest[]
}

model Event {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(120)
  venue       String   @db.VarChar(160)
  city        String   @db.VarChar(60)
  /// Stored in UTC; clients render it in Asia/Kolkata.
  startsAt    DateTime
  /// INR in paise (₹349 = 34900). Integers only, never floats.
  pricePaise  Int
  capacity    Int
  /// Guarded by CHECK (ticketsLeft >= 0) in the tickets_left_check migration; Prisma can't express CHECK.
  ticketsLeft Int
  createdAt   DateTime @default(now())
  tickets     Ticket[]

  @@index([startsAt])
}

model Ticket {
  id               String          @id @default(uuid()) @db.Char(36)
  /// 12 chars of Crockford base32; unique so a scanned code maps to exactly one ticket.
  code             String          @unique @db.Char(12)
  eventId          String          @db.Char(36)
  userId           String          @db.Char(36)
  checkedInAt      DateTime?
  createdAt        DateTime        @default(now())
  /// Set when the booking carried an Idempotency-Key; links the tickets to that request so a replay can return them.
  bookingRequestId String?         @db.Char(36)
  event            Event           @relation(fields: [eventId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([bookingRequestId])
}

/// One row per successful booking that carried an Idempotency-Key. The app resends a queued booking after a lost
/// connection with the same key; the unique (userId, idempotencyKey) pair makes the resend return the original
/// tickets instead of booking twice. Rows only exist for bookings that committed: a refused booking rolls back.
model BookingRequest {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @db.Char(36)
  idempotencyKey String   @db.Char(36)
  eventId        String   @db.Char(36)
  quantity       Int
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  tickets        Ticket[]

  @@unique([userId, idempotencyKey])
}
