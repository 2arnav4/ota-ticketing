# Copy to .env. The two URLs below match docker-compose.yml (local throwaway credentials, not secrets).
# Prod values live only in Vercel env vars.
DATABASE_URL=mysql://ota:ota_local@localhost:3306/ota
TEST_DATABASE_URL=mysql://ota:ota_local@localhost:3306/ota_test
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (web build URL in prod).
# To open the dev web app from a phone browser, add the LAN origin too, e.g. http://192.168.1.9:8081
CORS_ORIGINS=http://localhost:8081
# true for hosted MySQL (Aiven requires TLS); false for local Docker.
DATABASE_SSL=false
RATE_LIMIT_PER_MINUTE=30
# Hosted MySQL (Aiven) only: the service's CA certificate (Aiven console > service > Overview > CA certificate).
# Paste the PEM; on one line, write line breaks as \n. Leave empty for local Docker.
DATABASE_CA_CERT=
# Vercel Cron secret (16+ random chars). Leave empty locally: the reset route is then disabled.
CRON_SECRET=
